 * 1 = Forward (Controlled Speed), -1 = Reverse (Fast Turn), 0 = Stop
 */
// Upgraded Motor Function that handles backwards wiring in software!
void setMotors(int leftDir, int rightDir) {
  // Left Motor Logic
  if (leftDir == 1) { // Forward at BASE_SPEED
    analogWrite(DRIVE_LEFT_PIN_1, BASE_SPEED);
  
  // Apply software inversion if the user set it to true
  if (INVERT_LEFT_MOTOR) leftDir = -leftDir;
  if (INVERT_RIGHT_MOTOR) rightDir = -rightDir;

  // Left Motor
  if (leftDir == 1) { 
    analogWrite(DRIVE_LEFT_PIN_1, LEFT_SPEED);
digitalWrite(DRIVE_LEFT_PIN_2, LOW);
  } else if (leftDir == -1) { // Reverse for turning
  } else if (leftDir == -1) { 
digitalWrite(DRIVE_LEFT_PIN_1, LOW);
digitalWrite(DRIVE_LEFT_PIN_2, HIGH);
  } else { // Stop
  } else { 
digitalWrite(DRIVE_LEFT_PIN_1, LOW);
digitalWrite(DRIVE_LEFT_PIN_2, LOW);
}

  // Right Motor Logic
  if (rightDir == 1) { // Forward at BASE_SPEED
    analogWrite(DRIVE_RIGHT_PIN_1, BASE_SPEED);
  // Right Motor
  if (rightDir == 1) { 
    analogWrite(DRIVE_RIGHT_PIN_1, RIGHT_SPEED);
digitalWrite(DRIVE_RIGHT_PIN_2, LOW);
  } else if (rightDir == -1) { // Reverse for turning
  } else if (rightDir == -1) { 
digitalWrite(DRIVE_RIGHT_PIN_1, LOW);
digitalWrite(DRIVE_RIGHT_PIN_2, HIGH);
  } else { // Stop
  } else { 
digitalWrite(DRIVE_RIGHT_PIN_1, LOW);
digitalWrite(DRIVE_RIGHT_PIN_2, LOW);
}
}

