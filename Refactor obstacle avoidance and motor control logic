/**
 * Sets motor direction (1 for forward, 0 for stop).
 * UPGRADED: Sets motor direction. 
 * 1 = Forward, -1 = Reverse, 0 = Stop
*/
void setMotors(int leftSpeed, int rightSpeed) {
  digitalWrite(DRIVE_LEFT_PIN_1, LOW);
  digitalWrite(DRIVE_LEFT_PIN_2, leftSpeed > 0 ? HIGH : LOW);
  // Left Motor Logic
  if (leftSpeed == 1) { // Forward
    digitalWrite(DRIVE_LEFT_PIN_1, LOW);
    digitalWrite(DRIVE_LEFT_PIN_2, HIGH);
  } else if (leftSpeed == -1) { // Reverse
    digitalWrite(DRIVE_LEFT_PIN_1, HIGH);
    digitalWrite(DRIVE_LEFT_PIN_2, LOW);
  } else { // Stop
    digitalWrite(DRIVE_LEFT_PIN_1, LOW);
    digitalWrite(DRIVE_LEFT_PIN_2, LOW);
  }

  digitalWrite(DRIVE_RIGHT_PIN_1, LOW);
  digitalWrite(DRIVE_RIGHT_PIN_2, rightSpeed > 0 ? HIGH : LOW);
  // Right Motor Logic
  if (rightSpeed == 1) { // Forward
    digitalWrite(DRIVE_RIGHT_PIN_1, LOW);
    digitalWrite(DRIVE_RIGHT_PIN_2, HIGH);
  } else if (rightSpeed == -1) { // Reverse
    digitalWrite(DRIVE_RIGHT_PIN_1, HIGH);
    digitalWrite(DRIVE_RIGHT_PIN_2, LOW);
  } else { // Stop
    digitalWrite(DRIVE_RIGHT_PIN_1, LOW);
    digitalWrite(DRIVE_RIGHT_PIN_2, LOW);
  }
}

/**
* Sends a pulse and calculates distance in cm.
* Uses a timeout to prevent the robot from freezing if a ping is lost.
*/
long readDistance(int trigPin, int echoPin) {
  // Trigger the pulse
digitalWrite(trigPin, LOW);
delayMicroseconds(2);
digitalWrite(trigPin, HIGH); 
delayMicroseconds(10);
digitalWrite(trigPin, LOW);

  // Wait for the pulse to return, with a 30,000 microsecond timeout (~5 meters max)
long duration = pulseIn(echoPin, HIGH, 30000); 

  // If duration is 0, it means the timeout was reached (no obstacle detected)
if (duration == 0) {
return 999; 
}

  // Convert time to distance (d = t / 58)
return duration / 58; 
}
