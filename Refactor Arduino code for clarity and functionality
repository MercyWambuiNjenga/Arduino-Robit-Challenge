/**
 * Main loop: Handles decision making based on sensors and encoders.
 */
void loop()
{
  // 1. Check if the 2-meter goal has been reached
  if (leftEncoderTicks >= TARGET_TICKS || rightEncoderTicks >= TARGET_TICKS) {
    setMotors(0, 0);          // Stop motors
    setLED(LOW, LOW, HIGH);   // Set LED to BLUE
    return;                   // Skips the rest of the loop entirely
  }

  // 2. Read both ultrasonic sensors
  long leftDist = readDistance(LEFT_TRIG_PIN, LEFT_ECHO_PIN);
  long rightDist = readDistance(RIGHT_TRIG_PIN, RIGHT_ECHO_PIN);
  
  // 3. Obstacle Avoidance Logic
  if (leftDist < 20 || rightDist < 20) {
    // Obstacle detected: STOP
    setMotors(0, 0);
    setLED(HIGH, LOW, LOW);   // Set LED to RED
} 
else {
    // 2. Read sensor data 
    long leftDist = readDistance(LEFT_TRIG_PIN, LEFT_ECHO_PIN);
    long rightDist = readDistance(RIGHT_TRIG_PIN, RIGHT_ECHO_PIN);

    // 3. Obstacle Avoidance Logic 
    if (leftDist < 20 || rightDist < 20) {
      stopRobot();
      // Flash Red twice per second 
      setLeftLED(255, 0, 0);
      setRightLED(255, 0, 0);
      delay(250);
      setLeftLED(0, 0, 0);
      setRightLED(0, 0, 0);
      delay(250);
    } 
    // 4. Drive Forward 
    else {
      moveForward();
      // Set LEDs to Green while driving straight 
      setLeftLED(0, 255, 0);
      setRightLED(0, 255, 0);
    }
    // Path is clear: GO FORWARD
    setMotors(1, 1);
    setLED(LOW, HIGH, LOW);   // Set LED to GREEN
}
}

// --- Helper Functions ---

long readDistance(int trigPin, int echoPin) {
  digitalWrite(trigPin, LOW);
  delayMicroseconds(2);
  digitalWrite(trigPin, HIGH); 
  delayMicroseconds(10);
  digitalWrite(trigPin, LOW);
  long duration = pulseIn(echoPin, HIGH); 
  return duration / 58; // Distance in cm 
}

